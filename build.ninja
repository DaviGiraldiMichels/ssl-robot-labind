build STM32BluePillRadio.elf: CXX_EXECUTABLE_LINKER__STM32BluePillRadio CMakeFiles/STM32BluePillRadio.dir/Drivers/CMSIS/Device/ST/STM32F4xx/Source/Templates/system_stm32f4xx.c.obj CMakeFiles/STM32BluePillRadio.dir/Drivers/CMSIS/Device/ST/STM32F4xx/Source/Templates/gcc/startup_stm32f401xe.s.obj CMakeFiles/STM32BluePillRadio.dir/Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_cortex.c.obj CMakeFiles/STM32BluePillRadio.dir/Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_gpio.c.obj CMakeFiles/STM32BluePillRadio.dir/Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_rcc.c.obj CMakeFiles/STM32BluePillRadio.dir/Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_spi.c.obj CMakeFiles/STM32BluePillRadio.dir/Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_tim.c.obj CMakeFiles/STM32BluePillRadio.dir/Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_uart.c.obj CMakeFiles/STM32BluePillRadio.dir/Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_usart.c.obj CMakeFiles/STM32BluePillRadio.dir/Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal.c.obj CMakeFiles/STM32BluePillRadio.dir/src/main.c.obj CMakeFiles/STM32BluePillRadio.dir/src/app.cpp.obj CMakeFiles/STM32BluePillRadio.dir/src/syscalls.c.obj CMakeFiles/STM32BluePillRadio.dir/src/sysmem.c.obj CMakeFiles/STM32BluePillRadio.dir/src/ssl_kinematics.c.obj CMakeFiles/STM32BluePillRadio.dir/Drivers/RF24/RF24.cpp.obj CMakeFiles/STM32BluePillRadio.dir/Drivers/RF24/utility/STM32/compatibility.cpp.obj CMakeFiles/STM32BluePillRadio.dir/Drivers/RF24/utility/STM32/gpio.cpp.obj CMakeFiles/STM32BluePillRadio.dir/Drivers/RF24/utility/STM32/spi.cpp.obj CMakeFiles/STM32BluePillRadio.dir/src/setup_f4.c.obj
  FLAGS = -mcpu=cortex-m4 -mthumb -fdata-sections -ffunction-sections -MMD -MP -Wall -Wextra -Wfatal-errors -Wno-unused-parameter -Werror
  LINK_FLAGS = -mcpu=cortex-m4 -mthumb --specs=nano.specs -Wl,--gc-sections -Wl,--print-memory-usage
  LINK_LIBRARIES = -T/home/udesc/Conexao_SSL/RadioComm/linker/STM32F401RETX_FLASH.ld
  OBJECT_DIR = CMakeFiles/STM32BluePillRadio.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = STM32BluePillRadio.elf
  TARGET_PDB = STM32BluePillRadio.elf.dbg

# =============================================================================
# Target aliases.

build STM32BluePillRadio: phony STM32BluePillRadio.elf

